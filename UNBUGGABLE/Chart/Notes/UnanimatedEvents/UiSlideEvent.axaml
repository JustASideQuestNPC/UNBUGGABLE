<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UNBUGGABLE.Notes.UnanimatedEvents.UiSlideEventDialog">
    <UserControl.Styles>
        <StyleInclude Source="/Dialogs/DialogStyles.axaml" />
    </UserControl.Styles>
    
    <Border Classes="Container">
        <Grid RowDefinitions="50, 50, 50, 50, 50, 50, 50"
              ColumnDefinitions="Auto, 80, 10, Auto, 80" RowSpacing="5"
              ColumnSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                unanimated: slide ui in/out
            </TextBlock>
            <TextBlock Grid.Row="1" Grid.Column="0">all overlay ui</TextBlock>
            <!-- <ToggleButton Grid.Row="1" Grid.Column="1" Name="OverlayToggle" /> -->
            <Button Grid.Row="1" Grid.Column="1" Name="OverlayToggle" Click="ToggleButtonClick">
                <TextBlock Name="OverlayToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="1" Grid.Column="3">bg gradient</TextBlock>
            <Button Grid.Row="1" Grid.Column="4" Name="GradientToggle" Click="ToggleButtonClick">
                <TextBlock Name="GradientToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="2" Grid.Column="0">bg bars</TextBlock>
            <Button Grid.Row="2" Grid.Column="1" Name="BgBarsToggle" Click="ToggleButtonClick">
                <TextBlock Name="BgBarsToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="2" Grid.Column="3">4x3 bars</TextBlock>
            <Button Grid.Row="2" Grid.Column="4" Name="FourByThreeBarsToggle"
                    Click="ToggleButtonClick">
                <TextBlock Name="FourByThreeBarsToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="3" Grid.Column="0">left judgement</TextBlock>
            <Button Grid.Row="3" Grid.Column="1" Name="LeftJudgementToggle"
                    Click="ToggleButtonClick">
                <TextBlock Name="LeftJudgementToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="3" Grid.Column="3">right judgment</TextBlock>
            <Button Grid.Row="3" Grid.Column="4" Name="RightJudgementToggle"
                    Click="ToggleButtonClick">
                <TextBlock  Name="RightJudgementToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="4" Grid.Column="0">health</TextBlock>
            <Button Grid.Row="4" Grid.Column="1" Name="HealthBarToggle" Click="ToggleButtonClick">
                <TextBlock  Name="HealthBarToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="4" Grid.Column="3">speed lines</TextBlock>
            <Button Grid.Row="4" Grid.Column="4" Name="SpeedLinesToggle" Click="ToggleButtonClick">
                <TextBlock Name="SpeedLinesToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="5" Grid.Column="0">end time</TextBlock>
            <TextBox Grid.Row="5" Grid.Column="1" Name="EndTimeBox"
                     LostFocus="EndTimeBoxLostFocus" />
            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                <Button Classes="SquareIconButton" Click="ConfirmButtonClick">
                    <materialIcons:MaterialIcon Kind="Check" />
                </Button>
        
                <Button Classes="SquareIconButton" Click="CancelButtonClick">
                    <materialIcons:MaterialIcon Kind="Cancel" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
