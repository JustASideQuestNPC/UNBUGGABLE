<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:events="clr-namespace:UNBUGGABLE.Notes.UnanimatedEvents"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UNBUGGABLE.Notes.UnanimatedEvents.ChangeCharacterEventDialog">
    <UserControl.Styles>
        <StyleInclude Source="/Dialogs/DialogStyles.axaml" />
    </UserControl.Styles>
    
    <Border Classes="Container">
        <StackPanel Width="520" Spacing="5">
            <TextBlock>unanimated: change characters</TextBlock>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ComboBox Width="400" Name="PrimarySelectorBox"
                          SelectionChanged="PrimarySelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="events:CharacterSelectorBoxItem">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <materialIcons:MaterialIcon IconSize="22" Kind="AlertOutline"
                                            Name="PrimaryRequiresDlcAlertIcon">
                    <ToolTip.Tip>
                        <TextBlock>This character requires DLC</TextBlock>
                    </ToolTip.Tip>
                </materialIcons:MaterialIcon>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ComboBox Width="400" Name="AssistSelectorBox"
                          SelectionChanged="AssistSelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="events:CharacterSelectorBoxItem">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <materialIcons:MaterialIcon IconSize="22" Kind="AlertOutline"
                                            Name="AssistRequiresDlcAlertIcon">
                    <ToolTip.Tip>
                        <TextBlock>This character requires DLC</TextBlock>
                    </ToolTip.Tip>
                </materialIcons:MaterialIcon>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Height="50">
                <Button Classes="SquareIconButton" Click="ConfirmButtonClick">
                    <materialIcons:MaterialIcon Kind="Check" />
                </Button>
    
                <Button Classes="SquareIconButton" Click="CancelButtonClick">
                    <materialIcons:MaterialIcon Kind="Cancel" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
