<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UNBUGGABLE.Notes.UnanimatedEvents.UiShowHideEventDialog">
    <UserControl.Styles>
        <StyleInclude Source="/Dialogs/DialogStyles.axaml" />
    </UserControl.Styles>
    
    <Border Classes="Container">
        <Grid RowDefinitions="50, 50, 50, 50, 50, 50, 50, 50, 50, 50"
              ColumnDefinitions="Auto, 80, 10, Auto, 80" RowSpacing="5"
              ColumnSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                unanimated: show/hide ui
            </TextBlock>
            <TextBlock Grid.Row="1" Grid.Column="0">accuracy</TextBlock>
            <Button Grid.Row="1" Grid.Column="1" Name="AccuracyToggle" Click="ToggleButtonClick">
                <TextBlock Name="AccuracyToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="1" Grid.Column="3">bg bars</TextBlock>
            <Button Grid.Row="1" Grid.Column="4" Name="BgBarsToggle" Click="ToggleButtonClick">
                <TextBlock Name="BgBarsToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="2" Grid.Column="0">4x3 bars</TextBlock>
            <Button Grid.Row="2" Grid.Column="1" Name="FourByThreeBarsToggle"
                    Click="ToggleButtonClick">
                <TextBlock Name="FourByThreeBarsToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="2" Grid.Column="3">vignette</TextBlock>
            <Button Grid.Row="2" Grid.Column="4" Name="VignetteToggle" Click="ToggleButtonClick">
                <TextBlock Name="VignetteToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="3" Grid.Column="0">left judgement</TextBlock>
            <Button Grid.Row="3" Grid.Column="1" Name="LeftJudgementToggle"
                    Click="ToggleButtonClick">
                <TextBlock Name="LeftJudgementToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="3" Grid.Column="3">right judgment</TextBlock>
            <Button Grid.Row="3" Grid.Column="4" Name="RightJudgementToggle"
                    Click="ToggleButtonClick">
                <TextBlock Name="RightJudgementToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="4" Grid.Column="0">health</TextBlock>
            <Button Grid.Row="4" Grid.Column="1" Name="HealthToggle" Click="ToggleButtonClick">
                <TextBlock Name="HealthToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="4" Grid.Column="3">max combo</TextBlock>
            <Button Grid.Row="4" Grid.Column="4" Name="MaxComboToggle" Click="ToggleButtonClick">
                <TextBlock Name="MaxComboToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="5" Grid.Column="0">notes</TextBlock>
            <Button Grid.Row="5" Grid.Column="1" Name="NotesToggle" Click="ToggleButtonClick">
                <TextBlock Name="NotesToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="5" Grid.Column="3">reticle</TextBlock>
            <Button Grid.Row="5" Grid.Column="4" Name="ReticleToggle" Click="ToggleButtonClick">
                <TextBlock Name="ReticleToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="6" Grid.Column="0">score</TextBlock>
            <Button Grid.Row="6" Grid.Column="1" Name="ScoreToggle" Click="ToggleButtonClick">
                <TextBlock Name="ScoreToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="6" Grid.Column="3">speed lines</TextBlock>
            <Button Grid.Row="6" Grid.Column="4" Name="SpeedLinesToggle" Click="ToggleButtonClick">
                <TextBlock Name="SpeedLinesToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="7" Grid.Column="0">up next</TextBlock>
            <Button Grid.Row="7" Grid.Column="1" Name="UpNextToggle" Click="ToggleButtonClick">
                <TextBlock Name="UpNextToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="7" Grid.Column="3">measure bars</TextBlock>
            <Button Grid.Row="7" Grid.Column="4" Name="MeasureBarsToggle" Click="ToggleButtonClick">
                <TextBlock Name="MeasureBarsToggleText">none</TextBlock>
            </Button>
            <TextBlock Grid.Row="8" Grid.Column="0">end time</TextBlock>
            <TextBox Grid.Row="8" Grid.Column="1" Name="EndTimeBox"
                     LostFocus="EndTimeBoxLostFocus" />
            <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                <Button Classes="SquareIconButton" Click="ConfirmButtonClick">
                    <materialIcons:MaterialIcon Kind="Check" />
                </Button>
        
                <Button Classes="SquareIconButton" Click="CancelButtonClick">
                    <materialIcons:MaterialIcon Kind="Cancel" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
