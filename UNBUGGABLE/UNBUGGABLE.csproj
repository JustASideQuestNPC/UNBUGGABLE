    <ItemGroup>
      <None Update="Lib\SoundTouch.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <TargetPath>SoundTouch.dll</TargetPath>
      </None>
      <None Update="Lib\SoundTouch_x64.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
          <TargetPath>SoundTouch_x64.dll</TargetPath>
      </None>
      <None Update="Lib\COPYING.TXT">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
          <TargetPath>COPYING.txt</TargetPath>
      </None>
    </ItemGroup>

