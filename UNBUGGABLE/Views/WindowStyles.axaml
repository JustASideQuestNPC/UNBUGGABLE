<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->
    <Style Selector="Button.SquareIconButton">
        <Setter Property="Background" Value="{DynamicResource TopBar.Buttons.BackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TopBar.Buttons.OutlineColor}" />
        <Setter Property="BorderThickness" Value="{DynamicResource TopBar.Buttons.OutlineThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource TopBar.Buttons.CornerRadius}" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Width" Value="{Binding $self.Bounds.Height}" />
    </Style>
    <Style Selector="Button.SquareIconButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TopBar.Buttons.Hovered.BackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TopBar.Buttons.Hovered.OutlineColor}" />
    </Style>
    <Style Selector="materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource TopBar.Buttons.IconColor}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IconSize" Value="20" />
    </Style>
    
    <Style Selector="Button.SquareIconButton:pointerover materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource TopBar.Buttons.Hovered.IconColor}" />
    </Style>
    <Style Selector="Button.SquareIconButton:disabled materialIcons|MaterialIcon">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    
    <Style Selector="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource TopBar.Tooltips.TextColor}" />
        <Setter Property="Background" Value="{DynamicResource TopBar.Tooltips.BackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TopBar.Tooltips.OutlineColor}" />
        <Setter Property="BorderThickness" Value="{DynamicResource TopBar.Tooltips.OutlineThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource TopBar.Tooltips.CornerRadius}" />
        <Setter Property="FontFamily" Value="{DynamicResource RobotoMono}" />
        <Setter Property="FontSize" Value="{DynamicResource TopBar.Tooltips.TextSize}" />
        <Setter Property="ShowDelay" Value="150" />
    </Style>
    
    <Style Selector="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource RobotoMono}" />
        <Setter Property="Background" Value="{DynamicResource TopBar.Tooltips.BackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TopBar.Tooltips.OutlineColor}" />
        <Setter Property="BorderThickness" Value="{DynamicResource TopBar.Tooltips.OutlineThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource TopBar.Tooltips.CornerRadius}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="ContextMenu:dropdownopen /template/ Popup#PART_Popup > Border">
        <Setter Property="Background" Value="{DynamicResource TopBar.Tooltips.BackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TopBar.Tooltips.OutlineColor}" />
        <Setter Property="BorderThickness" Value="{DynamicResource TopBar.Tooltips.OutlineThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource TopBar.Tooltips.CornerRadius}" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource RobotoMono}" />
        <Setter Property="Foreground" Value="{DynamicResource TopBar.Tooltips.TextColor}" />
        <Setter Property="FontSize" Value="{DynamicResource TopBar.Tooltips.TextSize}" />
    </Style>
    
    <Style Selector="Slider:horizontal">
        <Style Selector="^ Track">
            <Style Selector="^ RepeatButton#PART_IncreaseButton Border">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Height" Value="{DynamicResource TopBar.Sliders.BottomThickness}" />
                <Setter Property="Background" Value="{DynamicResource TopBar.Sliders.BottomColor}" />
            </Style>
            <Style Selector="^ RepeatButton#PART_DecreaseButton Border">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Height" Value="{DynamicResource TopBar.Sliders.TopThickness}" />
                <Setter Property="Background" Value="{DynamicResource TopBar.Sliders.TopColor}" />
            </Style>
                    
            <Style Selector="^ Thumb">
                <Setter Property="Height" Value="{DynamicResource TopBar.Sliders.HandleHeight}" />
                <Setter Property="Width" Value="{DynamicResource TopBar.Sliders.HandleWidth}" />
                <Setter Property="Background" Value="{DynamicResource TopBar.Sliders.HandleColor}" />
            </Style>
        </Style>
    </Style>
    
    <Style Selector="#TopButtonBar Panel.Spacer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Width" Value="30" />
    </Style>
    
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource RobotoMono}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <!-- <Setter Property="MaxLines" Value="2" /> -->
    </Style>
    
    <Style Selector="#LeftSidePanel TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    
    <Style Selector="TextBlock.QuickInfoValues">
        <Setter Property="FontSize" Value="{DynamicResource QuickInfo.InfoSize}" />
        <Setter Property="Foreground" Value="{DynamicResource QuickInfo.InfoColor}" />
    </Style>
    
    <Style Selector="TextBlock.QuickInfoNames">
        <Setter Property="FontSize" Value="{DynamicResource QuickInfo.TitleSize}" />
        <Setter Property="Foreground" Value="{DynamicResource QuickInfo.TitleColor}" />
    </Style>
    
    <Style Selector="Border.EventIndicator">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background"
                Value="{DynamicResource MainWindow.EventIndicator.BackgroundColor}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Height" Value="40" />
        <Style.Animations>
            <Animation Duration="0:0:1.5" FillMode="Forward">
                <KeyFrame KeyTime="0.0">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame KeyTime="0:0:0.25">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
                <KeyFrame KeyTime="0:0:1.0">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
                <KeyFrame KeyTime="0:0:1.5">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.EventIndicator TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontSize"
                Value="{DynamicResource MainWindow.EventIndicator.TextSize}" />
        <Setter Property="Foreground"
                Value="{DynamicResource MainWindow.EventIndicator.TextColor}" />
        <Setter Property="FontFamily" Value="{DynamicResource RobotoMono}" />
    </Style>
    
    <Style Selector="ListBox">
        <Setter Property="Padding" Value="3" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="3" />
        <Setter Property="Background" Value="{DynamicResource Transparent}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>	
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>	
    </Style>
    
